{
  "name": "attention-timeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Every attention mechanism, in the order it actually launched.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "vite build --ssr src/ssr-smoke.tsx --outDir dist-ssr --logLevel warn && node dist-ssr/ssr-smoke.js",
    "build:netlify": "tsc -b && vite build --base=./ --outDir dist-netlify"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
